{
  "name": "maxxtoken-menubar",
  "private": true,
  "version": "0.2.13",
  "description": "MaxxToken menu bar app - reverse AI usage tracker that nudges you to use what you pay for",
  "main": "main.js",
  "bin": {
    "maxxtoken": "bin/maxxtoken.js",
    "maxxtoken-config": "bin/maxxtoken-config.js",
    "maxxtoken-usage": "bin/maxxtoken-usage.js",
    "maxxtoken-logs": "bin/maxxtoken-logs.js"
  },
  "scripts": {
    "start": "electron .",
    "tui": "node bin/maxxtoken.js",
    "providers": "node bin/maxxtoken-config.js providers",
    "usage": "node bin/maxxtoken-usage.js",
    "logs": "node bin/maxxtoken-logs.js --follow",
    "test": "node --test",
    "test:electron-popover": "node scripts/run-electron-popover-smoke.js",
    "dist": "npm run release:build",
    "release:build:mac": "electron-builder --mac dmg zip --universal --publish never",
    "release:build:win": "electron-builder --win nsis --x64 --publish never",
    "release:build": "npm run release:build:mac && npm run release:build:win",
    "release:refresh-manifests": "node scripts/refresh-release-manifests.js",
    "release:validate:build": "node scripts/validate-release.js --build-only",
    "release:validate": "node scripts/validate-release.js",
    "release": "npm run release:validate"
  },
  "build": {
    "beforePack": "native/before-pack.js",
    "appId": "audio.witch.maxxtoken",
    "productName": "MaxxToken",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "burn/**/*",
      "assets/**/*",
      "bin/**/*",
      "lib/**/*",
      "package.json"
    ],
    "mac": {
      "extraResources": [
        {
          "from": "native/bin/screen-capture-probe",
          "to": "screen-capture-probe"
        }
      ],
      "binaries": [
        "Contents/Resources/screen-capture-probe"
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}",
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "signIgnore": "\\.pak$",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MaxxToken"
    },
    "afterPack": "native/after-pack.js",
    "publish": {
      "provider": "github",
      "owner": "rachel-nocode",
      "repo": "maxxtoken"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "title": "MaxxToken ${version}",
      "icon": "assets/icon.icns",
      "iconSize": 112,
      "window": {
        "width": 660,
        "height": 420
      },
      "contents": [
        {
          "x": 170,
          "y": 255,
          "type": "file"
        },
        {
          "x": 490,
          "y": 255,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "node-fetch": "^2.7.0",
    "socks-proxy-agent": "^8.0.5"
  }
}
